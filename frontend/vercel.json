{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://premierpower-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://premierpower-api.onrender.com/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://premierpower-api.onrender.com/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://premierpower-api.onrender.com/robots.txt" },
    { "source": "/sqladmin", "destination": "https://premierpower-api.onrender.com/sqladmin" },
    { "source": "/sqladmin/:path*", "destination": "https://premierpower-api.onrender.com/sqladmin/:path*" },
    { "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; img-src 'self'; sandbox" },
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
