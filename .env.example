# Copy to .env before running docker compose.
#
# Host ports. Defaults avoid what this machine already runs (Postgres on 5432
# and 5438, Airflow on 8080, Superset on 8088). Change them if they clash.
WEB_PORT=8090
API_PORT=8010
DB_PORT=5440

# Database. Only reachable inside the compose network plus the host port above.
POSTGRES_USER=premierpower
POSTGRES_PASSWORD=premierpower
POSTGRES_DB=premierpower

# Admin CMS. Both are required — compose refuses to start without them.
ADMIN_USERNAME=admin
# The login for both the API and the admin UI.
ADMIN_EMAIL=admin@premierpower.co.ke
ADMIN_PASSWORD=

# Required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Origins allowed to call the API directly. The site itself is same-origin.
CORS_ORIGINS=http://localhost:8090

# Where new lead notifications go (optional; logged when unset).
NOTIFY_EMAIL=

# Set to 1 to build the frontend with sample data and the demo ribbon.
VITE_DEMO=

# Optional image CDN. Unset means uploads are stored on the api volume
# and served from /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
