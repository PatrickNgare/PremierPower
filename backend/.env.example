# Postgres. On Render this is provided as DATABASE_URL.
DATABASE_URL=postgresql+psycopg://premierpower:premierpower@localhost:5432/premierpower

# Admin CMS login. Change both before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signing key for the admin session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Where new lead notifications are sent (optional; logged if unset).
NOTIFY_EMAIL=
