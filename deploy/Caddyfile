# Caddy gets and renews a Let's Encrypt certificate on its own. The only
# requirements are that SITE_DOMAIN resolves to this machine and that ports 80
# and 443 are open in the security group — HTTP-01 validation needs port 80
# reachable, which is why it is published even though everything redirects.

{$SITE_DOMAIN} {
	encode zstd gzip

	# The app is unchanged behind here: nginx still serves the SPA and proxies
	# /api to the API on the compose network, so nothing knows it is proxied.
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# nginx already sets the rest; HSTS belongs at the TLS edge, which is here.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
